<?xml version="1.0" encoding="utf-8"?>
<!-- Uploaded images are static, read-only content: never execute anything from this folder. -->
<configuration>
  <system.webServer>
    <handlers>
      <clear />
      <add name="StaticFileOnly" path="*" verb="GET,HEAD" modules="StaticFileModule" resourceType="File" requireAccess="Read" />
    </handlers>
  </system.webServer>
</configuration>
