<?xml version="1.0" encoding="utf-8"?>
<!-- TEST configuration only. Fake values; nothing here is a real credential or endpoint. -->
<configuration>
  <connectionStrings>
    <!-- Closed local port: the login test expects a connection failure, never a real database. -->
    <add name="BillerRestoDb" connectionString="Server=127.0.0.1;Port=1;Database=unit_test_db;Uid=unit_test_user;Pwd=UnitTestOnlyPw-9f3a;Connection Timeout=2;" providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
  <appSettings>
    <add key="Logging:Directory" value="testlogs" />
    <add key="Logging:MaxTotalMB" value="10" />
    <!-- Optional: a LOCAL test MariaDB/MySQL server. LoginFlowTests create a uniquely named throw-away schema
         (biller_ut_*) on it and drop it afterwards; they never touch any existing schema. Tests are skipped
         (Inconclusive) when it is unreachable. Never point this at a shared or production server. -->
    <add key="Test:AdminConnection" value="Server=127.0.0.1;Port=3306;Uid=root;Pwd=;Connection Timeout=3;" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" culture="neutral" publicKeyToken="30ad4fe6b2a6aeed" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
