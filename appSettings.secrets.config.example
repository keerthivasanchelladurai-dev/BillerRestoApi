<?xml version="1.0" encoding="utf-8"?>
<!-- Copy to appSettings.secrets.config on each server and put a unique random value (>= 32 chars,
     e.g. 48 random bytes base64) in value. Never commit the real file or reuse keys across environments. -->
<appSettings>
  <add key="Auth:SigningKey" value="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS" />
</appSettings>
